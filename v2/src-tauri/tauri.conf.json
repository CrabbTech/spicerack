{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quire",
  "version": "2.0.0",
  "identifier": "com.tydacrabb.spicerack2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quire",
        "width": 1400,
        "height": 940,
        "minWidth": 1040,
        "minHeight": 700,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 19
        },
        "backgroundColor": "#cbc1a9"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "12.0"
    }
  }
}
